{% extends 'base.html.twig' %}

{% block title %}Resumen Locals{% endblock %}

{% block body %}
    {% embed 'owner/_shell.html.twig' with { owner_user: owner_user, active: 'dashboard' } %}
        {% block locals_title %}Resumen{% endblock %}

        {% block locals_content %}
            {% set has_locations = locations is not empty %}
            {% set completion_total = 3 %}
            {% set completion_done = (has_locations ? 1 : 0) + (stats.access_count > 0 ? 1 : 0) + (stats.staff_count > 1 ? 1 : 0) %}
            {% set completion_percent = ((completion_done / completion_total) * 100)|round(0, 'floor') %}

            <section class="locals-hero">
                <div class="locals-hero__copy">
                    <p class="locals-eyebrow">Mi Local</p>
                    <h3>{{ stats.pending_core_connection ? 'Conecta tu presencia pública' : 'Tu local está listo para mantenerse al día' }}</h3>
                    <p>{{ stats.pending_core_connection ? 'Cuando tu acceso quede asociado con Core podrás completar datos públicos, servicios, horarios, media y redes.' : 'Revisa la información visible, mantén horarios y servicios actualizados, y controla quién puede entrar al panel.' }}</p>
                    <div class="locals-hero__actions">
                        <a href="{{ path('locals_location_profile') }}" class="locals-action">Editar mi local</a>
                        <a href="{{ path('locals_staff_index') }}" class="locals-action locals-action--secondary">Gestionar staff</a>
                    </div>
                </div>
                <div class="locals-progress-card">
                    <span>Preparación alpha</span>
                    <strong>{{ completion_percent }}%</strong>
                    <div class="locals-progress" aria-hidden="true">
                        <span style="width: {{ completion_percent }}%"></span>
                    </div>
                    <p>{{ completion_done }} de {{ completion_total }} pasos base completos</p>
                </div>
            </section>

            <section class="locals-grid locals-grid--stats">
                <article class="locals-card">
                    <span>Accesos del equipo</span>
                    <strong>{{ stats.staff_count }}</strong>
                    <p>Personas con cuenta en la consola del local.</p>
                </article>
                <article class="locals-card">
                    <span>Locales asociados</span>
                    <strong>{{ stats.access_count }}</strong>
                    <p>Permisos conectados con ubicaciones canónicas.</p>
                </article>
                <article class="locals-card">
                    <span>Estado operativo</span>
                    <strong>{{ stats.pending_core_connection ? 'Pendiente' : 'Activo' }}</strong>
                    <p>{{ stats.pending_core_connection ? 'Falta asociar tu cuenta con un local canónico.' : 'Tu cuenta ya tiene acceso asociado.' }}</p>
                </article>
            </section>

            <section class="locals-task-panel">
                <header>
                    <p class="locals-eyebrow">Siguiente acción</p>
                    <h3>{{ stats.pending_core_connection ? 'Esperar asociación del local' : 'Completar perfil visible' }}</h3>
                </header>
                <div class="locals-task-list">
                    <a href="{{ path('locals_location_profile') }}" class="locals-task {{ has_locations ? 'is-done' : '' }}">
                        <span></span>
                        <div>
                            <strong>Perfil público</strong>
                            <p>{{ has_locations ? 'Disponible para edición según permiso.' : 'Aparecerá cuando exista un local asociado.' }}</p>
                        </div>
                    </a>
                    <a href="{{ path('locals_location_profile') }}" class="locals-task {{ stats.access_count > 0 ? 'is-done' : '' }}">
                        <span></span>
                        <div>
                            <strong>Permiso Core</strong>
                            <p>{{ stats.access_count > 0 ? 'La cuenta ya tiene relación con ubicación.' : 'Pendiente de claim, invitación o sincronización.' }}</p>
                        </div>
                    </a>
                    <a href="{{ path('locals_staff_index') }}" class="locals-task {{ stats.staff_count > 1 ? 'is-done' : '' }}">
                        <span></span>
                        <div>
                            <strong>Equipo</strong>
                            <p>{{ stats.staff_count > 1 ? 'Ya existe más de una cuenta registrada.' : 'Agrega staff cuando delegues operación.' }}</p>
                        </div>
                    </a>
                </div>
            </section>

            {% if locations is not empty %}
                <section class="locals-table-card">
                    <table class="locals-table">
                        <thead>
                            <tr>
                                <th>Local</th>
                                <th>Categoría</th>
                                <th>Zona</th>
                                <th>Estado</th>
                                <th>Permiso</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for location in locations %}
                                <tr>
                                    <td>
                                        <strong>{{ location.name }}</strong><br>
                                        <span>{{ location.slug }}</span>
                                    </td>
                                    <td>{{ location.category_name|default('Sin categoría') }}</td>
                                    <td>{{ [location.neighborhood, location.city]|filter(v => v is not empty)|join(', ')|default('Sin zona') }}</td>
                                    <td>
                                        <span class="locals-status">{{ location.publication_state }}</span>
                                    </td>
                                    <td>{{ location.access_role }}</td>
                                    <td>
                                        <a class="locals-table-action" href="{{ path('locals_location_profile_edit', { coreLocationId: location.core_location_id }) }}">Editar</a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </section>
            {% endif %}
        {% endblock %}
    {% endembed %}
{% endblock %}
