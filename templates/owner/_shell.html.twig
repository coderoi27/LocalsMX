{% set active = active|default('dashboard') %}

<div class="flex flex-col min-h-screen pl-64">
    <!-- Sidebar -->
    <aside class="fixed top-0 left-0 h-screen w-64 glass-panel border-r border-white/40 z-20 flex flex-col">
        <div class="h-16 flex items-center px-6 border-b border-white/20">
            <span class="text-xl font-bold tracking-tight bg-gradient-to-r from-orange-500 to-red-500 bg-clip-text text-transparent">Mi Monchis</span>
            <span class="ml-2 text-sm font-semibold text-gray-500 uppercase">Locals</span>
        </div>
        <nav class="flex-1 overflow-y-auto py-4 px-3 space-y-1">
            <a href="{{ path('locals_dashboard') }}" class="block px-3 py-2.5 rounded-xl transition-colors font-medium {{ active == 'dashboard' ? 'bg-white/60 text-orange-600 shadow-sm' : 'hover:bg-white/50 text-gray-700' }}">Resumen</a>
            <a href="{{ path('locals_location_profile') }}" class="block px-3 py-2.5 rounded-xl transition-colors font-medium {{ active == 'location' ? 'bg-white/60 text-orange-600 shadow-sm' : 'hover:bg-white/50 text-gray-700' }}">Mi local</a>
            <a href="{{ path('locals_staff_index') }}" class="block px-3 py-2.5 rounded-xl transition-colors font-medium {{ active == 'staff' ? 'bg-white/60 text-orange-600 shadow-sm' : 'hover:bg-white/50 text-gray-700' }}">Staff</a>
        </nav>
        
        <div class="p-4 border-t border-white/20">
            <div class="mb-4">
                <p class="text-xs text-gray-500 font-bold uppercase tracking-wider mb-1">Cuenta activa</p>
                <p class="font-bold text-gray-900 truncate">{{ owner_user.fullName }}</p>
                <p class="text-xs text-gray-500">{{ owner_user.roleKey }}</p>
            </div>
            <form method="post" action="{{ path('locals_logout') }}">
                <button type="submit" class="w-full glass-btn text-red-600 hover:text-red-700">Cerrar sesión</button>
            </form>
        </div>
    </aside>

    <!-- Main Content -->
    <header class="h-16 glass-panel border-b border-white/40 sticky top-0 z-10 flex items-center px-8 justify-between">
        <h2 class="text-xl font-bold text-gray-800 tracking-tight">{% block locals_title %}Resumen{% endblock %}</h2>
        <div class="flex items-center gap-3">
            <span class="text-sm font-medium text-gray-600">{{ owner_user.fullName }}</span>
            <div class="h-8 w-8 rounded-full bg-gradient-to-tr from-orange-400 to-red-400 shadow-inner flex items-center justify-center text-white font-bold text-sm">
                {{ owner_user.fullName|slice(0, 1) }}
            </div>
        </div>
    </header>

    <main class="flex-1 p-8">
        {% for message in app.flashes('success') %}
            <div class="mb-6 p-4 rounded-xl bg-green-500/20 backdrop-blur-md border border-green-500/30 text-green-800 font-medium">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="mb-6 p-4 rounded-xl bg-red-500/20 backdrop-blur-md border border-red-500/30 text-red-800 font-medium">{{ message }}</div>
        {% endfor %}

        {% block locals_content %}{% endblock %}
    </main>
</div>
