{% extends 'base.html.twig' %}

{% block title %}Acceso Alpha | Mi Monchis MX{% endblock %}

{% block body %}
    <main class="alpha-gate">
        <section class="alpha-gate__card">
            <p class="alpha-gate__eyebrow">Version alpha privada</p>
            <h1 class="alpha-gate__title">Accede con tu invitacion</h1>
            <p class="alpha-gate__copy">
                Esta demo es exclusiva para invitados del evento. Usa tu token o codigo de acceso para entrar a Mi Monchis.
            </p>

            {% if error %}
                <div class="alpha-gate__error">{{ error }}</div>
            {% endif %}

            <form method="post" class="alpha-gate__form">
                <label class="alpha-gate__label" for="access_code">Token o codigo de invitacion</label>
                <input
                    id="access_code"
                    name="access_code"
                    type="text"
                    value="{{ prefilled_access_code }}"
                    class="alpha-gate__input"
                    placeholder="Pega aqui tu token o codigo"
                    autofocus
                >
                <button type="submit" class="alpha-gate__submit">Entrar a la demo</button>
            </form>

            <div class="alpha-gate__hint">
                Si llegaste desde un enlace de invitacion, el acceso se validara automaticamente.
            </div>
        </section>
    </main>
{% endblock %}
