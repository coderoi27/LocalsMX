{% extends 'base.html.twig' %}

{% block title %}Acceso Locals{% endblock %}

{% block body %}
    <main class="locals-auth">
        <section class="locals-auth__panel">
            <p class="locals-eyebrow">Mi Monchis MX Locals</p>
            <h1>Acceso para dueños</h1>
            <p>Administra la información operativa de tu local y el acceso de tu equipo.</p>

            {% for message in app.flashes('success') %}
                <div class="locals-flash locals-flash--success">{{ message }}</div>
            {% endfor %}

            {% if error %}
                <div class="locals-flash locals-flash--error">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" class="locals-form">
                <label for="username">Correo</label>
                <input id="username" type="email" name="_username" value="{{ last_username }}" required autofocus autocomplete="email">

                <label for="password">Contraseña</label>
                <input id="password" type="password" name="_password" required autocomplete="current-password">

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit">Entrar</button>
            </form>

            <p class="locals-auth__footer">
                ¿Aún no tienes cuenta?
                <a href="{{ path('locals_register') }}">Crear acceso de dueño</a>
            </p>
        </section>
    </main>
{% endblock %}
