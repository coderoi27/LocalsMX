{% extends 'base.html.twig' %}

{% block title %}Crear acceso Locals{% endblock %}

{% block body %}
    <main class="locals-auth">
        <section class="locals-auth__panel">
            <p class="locals-eyebrow">Mi Monchis MX Locals</p>
            <h1>Crear acceso de dueño</h1>
            <p>Este acceso abre la consola del local. La conexión con un local reclamado o registrado se completa después desde Core/Admin.</p>

            {% if error is defined %}
                <div class="locals-flash locals-flash--error">{{ error }}</div>
            {% endif %}

            <form method="post" class="locals-form">
                <label for="full_name">Nombre completo</label>
                <input id="full_name" type="text" name="full_name" required autocomplete="name">

                <label for="email">Correo</label>
                <input id="email" type="email" name="email" required autocomplete="email">

                <label for="password">Contraseña</label>
                <input id="password" type="password" name="password" required autocomplete="new-password">

                <button type="submit">Crear cuenta</button>
            </form>

            <p class="locals-auth__footer">
                ¿Ya tienes cuenta?
                <a href="{{ path('locals_login') }}">Entrar al panel</a>
            </p>
        </section>
    </main>
{% endblock %}
